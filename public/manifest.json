{
  "manifest_version": 3,
  "name": "GitHub Status Indicator",
  "description": "GitHub service status at a glance. No account, tracking, or setup.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://www.githubstatus.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitHub: Status Unavailable",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": { "service_worker": "background/index.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
