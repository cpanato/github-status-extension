{
  "name": "github-status-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "build": "bash scripts/build.sh",
    "test": "tsc -p tsconfig.test.json && node --test .test/tests/*.test.js",
    "test:e2e": "playwright test",
    "test:release": "bash tests/release.test.sh",
    "package": "npm run build && bash scripts/package.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/chrome": "0.1.24",
    "@types/node": "24.10.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
